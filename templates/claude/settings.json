{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.orchestrator/hooks/decision-index.sh\"",
            "timeout": 10,
            "statusMessage": "Loading the decision index",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "skillListingMaxDescChars": 300,
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "120000"
  },
  "enabledPlugins": {}
}
